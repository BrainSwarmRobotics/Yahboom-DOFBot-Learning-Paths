<?xml version="1.0"?>
<!-- DOFBOT learning path world: dofbot_gazebo's dofbot_mat.sdf (Yahboom's colour mat, the 4 blocks
     stacked on the centre square) plus a fixed overview camera, so the arm can be watched from a
     browser-only console with:  ros2 run dofbot_lab snapshot.py -->
<sdf version="1.8">
  <world name="dofbot_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.75 0.8 0.85</background_color>
        <camera_pose>0.55 0.75 0.45 0 0.45 -2.2</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">72</property><property type="double" key="width">121</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">110</property><property type="double" key="width">290</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </ignition-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
      <plugin filename="ImageDisplay" name="Wrist camera">
        <ignition-gui><title>Wrist camera</title><property type="string" key="state">docked</property></ignition-gui>
        <topic>dofbot/camera/image_raw</topic>
        <topic_picker>false</topic_picker>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui><property type="string" key="state">docked</property></ignition-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui><property type="string" key="state">docked</property></ignition-gui>
      </plugin>
    </gui>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <!-- The desk the arm stands on -->
    <model name="desk">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <!-- paper/wood: a block on the mat slides (rather than tips) when a finger pushes it -->
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material><ambient>0.55 0.42 0.3 1</ambient><diffuse>0.55 0.42 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Yahboom colour mat (visual only, so blocks slide over it cleanly) -->
    <model name="mat">
      <static>true</static>
      <link name="link">
      <visual name="paper">
        <cast_shadows>false</cast_shadows>
        <pose>0 0.2 0.0006 0 0 0</pose>
        <geometry><box><size>0.42 0.3 0.0004</size></box></geometry>
        <material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material>
      </visual>
      <visual name="sq_yellow">
        <cast_shadows>false</cast_shadows>
        <pose>0.124 0.266 0.0012 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.0004</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
      </visual>
      <visual name="sq_red">
        <cast_shadows>false</cast_shadows>
        <pose>-0.133 0.261 0.0012 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.0004</size></box></geometry>
        <material><ambient>0.85 0.12 0.1 1</ambient><diffuse>0.85 0.12 0.1 1</diffuse></material>
      </visual>
      <visual name="sq_green">
        <cast_shadows>false</cast_shadows>
        <pose>-0.136 0.132 0.0012 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.0004</size></box></geometry>
        <material><ambient>0.1 0.65 0.2 1</ambient><diffuse>0.1 0.65 0.2 1</diffuse></material>
      </visual>
      <visual name="sq_blue">
        <cast_shadows>false</cast_shadows>
        <pose>0.135 0.13 0.0012 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.0004</size></box></geometry>
        <material><ambient>0.1 0.3 0.85 1</ambient><diffuse>0.1 0.3 0.85 1</diffuse></material>
      </visual>
      <visual name="sq_grey">
        <cast_shadows>false</cast_shadows>
        <pose>0.0 0.221 0.0012 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.0004</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
      </link>
    </model>

    <model name="block_blue">
      <pose>0.0 0.221 0.0155 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>3.000e-06</ixx><iyy>3.000e-06</iyy><izz>3.000e-06</izz></inertia></inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>10</kd><min_depth>0.001</min_depth><max_vel>0.01</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.1 0.3 0.85 1</ambient><diffuse>0.1 0.3 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="block_green">
      <pose>0.0 0.221 0.0455 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>3.000e-06</ixx><iyy>3.000e-06</iyy><izz>3.000e-06</izz></inertia></inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>10</kd><min_depth>0.001</min_depth><max_vel>0.01</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.1 0.65 0.2 1</ambient><diffuse>0.1 0.65 0.2 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="block_red">
      <pose>0.0 0.221 0.0755 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>3.000e-06</ixx><iyy>3.000e-06</iyy><izz>3.000e-06</izz></inertia></inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>10</kd><min_depth>0.001</min_depth><max_vel>0.01</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.85 0.12 0.1 1</ambient><diffuse>0.85 0.12 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="block_yellow">
      <pose>0.0 0.221 0.1055 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>3.000e-06</ixx><iyy>3.000e-06</iyy><izz>3.000e-06</izz></inertia></inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>10</kd><min_depth>0.001</min_depth><max_vel>0.01</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Overview camera: a fixed view of the arm and the mat, bridged to /overview_camera/image_raw.
         Looks at the arm and the mat from the front right. -->
    <model name="overview_camera">
      <static>true</static>
      <pose>0.70 0.75 0.55 0 0.38 -2.41</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>lab/overview_camera/image</topic>
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>800</width><height>600</height></image>
            <clip><near>0.05</near><far>5</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
